# Copy this file to backend/.env for local development. Do not commit real credentials.

# Runtime and persistence
IKEORU_ENV=development
IKEORU_DATABASE_URL=sqlite:///./ikeoru.db

# AI mode: mock is deterministic local development/test behaviour. Use live only
# after supplying a server-side key, selected model, session secret, and budget limit.
IKEORU_AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=

# Server-side security and browser access
IKEORU_SESSION_SECRET=
IKEORU_CORS_ORIGINS=http://localhost:5173

# Protective execution limits. The timeout bounds one live OpenAI request;
# it is not a deadline for the entire background workflow.
IKEORU_LIVE_RUN_DAILY_LIMIT=10
IKEORU_RUN_TIMEOUT_SECONDS=60
